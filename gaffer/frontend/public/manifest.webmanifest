{
  "id": "/",
  "name": "Gaffer FPL planner",
  "short_name": "Gaffer",
  "description": "Expected points, transfers, captaincy, insights and weekly results for Fantasy Premier League.",
  "start_url": "/#/home",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#12382a",
  "theme_color": "#12382a",
  "categories": ["sports", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My team", "url": "/#/team", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Weekly results", "url": "/#/results", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Insights", "url": "/#/insights", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
